{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Per-modality multi-analyst ensemble roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modality", "statistical_variants", "interpretive_lenses", "caps"],
  "properties": {
    "schema_version": { "type": "string" },
    "modality": { "type": "string" },
    "enabled": { "type": "boolean" },
    "factorial": { "enum": ["full", "fractional"] },
    "statistical_variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tool"],
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string" },
          "bootstrap_replicates": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "interpretive_lenses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "persona_ref", "model_tier"],
        "properties": {
          "id": { "type": "string" },
          "persona_ref": { "type": "string" },
          "model_tier": { "type": "string" },
          "retrieval": { "type": "string" },
          "model": { "type": "string" }
        }
      }
    },
    "caps": {
      "type": "object", "additionalProperties": false,
      "required": ["max_ensemble_members", "per_ensemble_budget_usd", "min_quorum_per_axis"],
      "properties": {
        "max_ensemble_members": { "type": "integer", "minimum": 1 },
        "per_ensemble_budget_usd": { "type": "number", "minimum": 0 },
        "min_quorum_per_axis": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
