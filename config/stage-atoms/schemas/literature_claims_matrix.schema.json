{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiteratureClaimsMatrixRow",
  "description": "Row schema for prior_claims_matrix.csv emitted by review_prior_work. Each row is one source-anchored prior-work claim with a verbatim evidence quote. Rows are anchored by a typed locator: legacy PMID-only rows carry `pmid`; locator-generalized rows carry `source_ref_kind` + `source_ref` (PMID/DOI/arXiv/URL). `pmid`/`prior_pmids` remain optional for back-compat.",
  "type": "object",
  "required": ["entity", "entity_kind", "evidence_quote", "evidence_quote_offset",
               "source_kind", "source_hash", "retrieval_ts", "redistributable", "verified"],
  "additionalProperties": false,
  "properties": {
    "entity": { "type": "string", "minLength": 1 },
    "entity_kind": { "type": "string", "enum": ["gene", "region", "variant", "pathway", "cell_type"] },
    "pmid": { "type": "string", "pattern": "^[1-9][0-9]{6,8}$" },
    "prior_pmids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[1-9][0-9]{6,8}$" }
    },
    "source_ref_kind": { "type": "string", "enum": ["pmid", "doi", "arxiv", "url"] },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_class": { "type": "string", "enum": ["primary_literature", "conference_proceedings", "tool_documentation"] },
    "evidence_role": { "type": "string", "enum": ["recommendation_or_benchmark", "capability_or_version"] },
    "version_context": { "type": "string" },
    "evidence_quote": { "type": "string", "minLength": 1 },
    "evidence_quote_offset": { "type": "integer", "minimum": 0 },
    "source_kind": { "type": "string", "enum": ["pmc_oa_full_text", "abstract_only", "external_pdf_local_only", "openalex", "crossref", "doc_page"] },
    "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "retrieval_ts": { "type": "string", "format": "date-time" },
    "redistributable": { "type": "boolean" },
    "verified": { "type": "boolean" }
  }
}
