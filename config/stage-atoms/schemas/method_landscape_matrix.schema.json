{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MethodLandscapeMatrixRow",
  "description": "Row schema for method_landscape.csv emitted by survey_method_landscape. Each row is one candidate method on one runtime method-choice axis, anchored to a single resolvable source (PMID/DOI/arXiv/URL) with a verbatim, substring-verifiable evidence_quote. No ranking or synthesis: the downstream discover_* atoms rank curated ∪ literature-surfaced candidates deterministically from this table.",
  "type": "object",
  "required": ["axis", "candidate_method", "source_ref_kind", "source_ref",
               "source_class", "evidence_role", "evidence_quote", "evidence_quote_offset",
               "source_kind", "source_hash", "retrieval_ts", "redistributable", "verified",
               "version_context", "pmid"],
  "additionalProperties": false,
  "properties": {
    "axis": { "type": "string", "minLength": 1 },
    "candidate_method": { "type": "string", "minLength": 1 },
    "pmid": { "type": "string", "pattern": "^$|^[1-9][0-9]{6,8}$" },
    "source_ref_kind": { "type": "string", "enum": ["", "pmid", "doi", "arxiv", "url"] },
    "source_ref": { "type": "string" },
    "source_class": { "type": "string", "enum": ["curated_baseline", "primary_literature", "conference_proceedings", "tool_documentation"] },
    "evidence_role": { "type": "string", "enum": ["", "recommendation_or_benchmark", "capability_or_version"] },
    "version_context": { "type": "string" },
    "evidence_quote": { "type": "string" },
    "evidence_quote_offset": { "type": "integer", "minimum": 0 },
    "source_kind": { "type": "string", "enum": ["", "pmc_oa_full_text", "abstract_only", "pubmed_abstract", "pubmed_abstract_xml", "pubmed_efetch_xml_batch", "external_pdf_local_only", "openalex", "crossref", "doc_page"] },
    "source_hash": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
    "retrieval_ts": { "type": "string", "format": "date-time" },
    "redistributable": { "type": "boolean" },
    "verified": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_class": { "const": "curated_baseline" } } },
      "then": {
        "properties": {
          "source_ref_kind": { "const": "" },
          "source_ref": { "const": "" },
          "evidence_quote": { "const": "" },
          "source_kind": { "const": "" },
          "source_hash": { "const": "" },
          "verified": { "const": false }
        }
      },
      "else": {
        "properties": {
          "source_ref": { "minLength": 1 },
          "evidence_quote": { "minLength": 1 },
          "source_hash": { "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  ]
}
