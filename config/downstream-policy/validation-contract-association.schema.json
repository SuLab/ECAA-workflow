{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://ecaa-workflow/validation-contract-association.schema.json",
  "title": "Validation contract — differential-expression / regression method-correctness assertions",
  "type": "object",
  "required": ["contract_id", "stages"],
  "additionalProperties": false,
  "properties": {
    "contract_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["assertions"],
        "additionalProperties": false,
        "properties": {
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "assertion_type", "target", "severity"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "assertion_type": {
                  "type": "string",
                  "enum": [
                    "artifact_present",
                    "artifact_non_empty_table",
                    "artifact_glob_any",
                    "string_contains",
                    "numeric_threshold",
                    "numeric_distribution",
                    "reference_range_outlier",
                    "positive_control_present",
                    "negative_control_present",
                    "json_pointer_is_bool",
                    "json_pointer_is_array",
                    "cross_stage_output_comparison",
                    "cross_stage_table_handoff",
                    "table_header_has_all_groups",
                    "cross_field_equals",
                    "formula_references_covariates"
                  ]
                },
                "target": { "type": "string", "minLength": 1 },
                "check": { "type": "object" },
                "when": {
                  "type": "object",
                  "description": "Optional guard: the assertion runs only when this predicate holds, else it is skipped (not applicable, never blocks). Used to scope the method-correctness assertions to records that carry the relevant field (/available_covariates, /stated_outcome).",
                  "required": ["json_pointer"],
                  "additionalProperties": false,
                  "properties": {
                    "json_pointer": { "type": "string", "minLength": 1 },
                    "target": { "type": "string", "minLength": 1 },
                    "equals": {}
                  }
                },
                "severity": { "type": "string", "enum": ["required", "recommended"] }
              }
            }
          }
        }
      }
    }
  }
}
