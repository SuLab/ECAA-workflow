#!/usr/bin/env bash
# ecaa-install — the standard package-install verb for execution agents.
#
# Usage:
#   ecaa-install py   <pip-pkg>...     # Python via pip (user/site cache)
#   ecaa-install r    <CRAN-pkg>...    # R via install.packages
#   ecaa-install bioc <Bioc-pkg>...    # R/Bioconductor via bioconda binary
#                                      # (falls back to BiocManager only when
#                                      #  no bioconda binary exists for a pkg)
#
# Why a verb instead of raw pip/conda/mamba/BiocManager:
#  - ONE method per ecosystem, so installs are deterministic and the
#    per-session cache (PIP_CACHE_DIR / R_LIBS_USER / CONDA_PKGS_DIRS) is
#    actually reused across sibling tasks — a heavy install (DESeq2, fgsea)
#    happens once per session, not once per task.
#  - R packages install into R_LIBS_USER, which is *prepended* to the base
#    .libPaths(). Base packages (ragg, cairo, grid) stay importable, so the
#    shipped renderer's graphics backend keeps working — unlike an isolated
#    conda R env, which silently drops base graphics ("no package 'ragg'").
#  - Idempotent: already-present packages are skipped fast.
#  - bioc installs use the pre-built bioconda binary (no C++ source compile)
#    into the shared 'ecaa-bioc' conda env (CONDA_ENVS_DIRS is already
#    redirected to a writable cache by the run environment).
set -uo pipefail

eco="${1:-}"; shift || true
if [ -z "$eco" ] || [ "$#" -eq 0 ]; then
  echo "usage: ecaa-install <py|r|bioc> <pkg>..." >&2
  exit 2
fi

PY="${ECAA_PY:-python3}"
RSCRIPT="${ECAA_RSCRIPT:-Rscript}"
CRAN="${ECAA_CRAN_REPO:-https://cloud.r-project.org}"

# Best-effort runtime provenance (NEVER fails the install).
#
# The package-level JSONL is the machine-readable source of truth. A concise
# per-task transcript is also written automatically because asking the agent to
# remember a shell redirection left image-provided packages entirely absent
# from otherwise replayable runs.
_log_install() {
  local reg="$1" pkg="$2" ver="$3" action="${4:-resolved}"
  local logdir="${ECAA_PACKAGE_DIR:-${PACKAGE:-}}"
  [ -z "$logdir" ] && return 0
  local logfile="$logdir/runtime/install-log.jsonl"
  mkdir -p "$(dirname "$logfile")" 2>/dev/null || return 0
  local task_id="${ECAA_TASK_ID:-}" timestamp record
  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  if command -v jq >/dev/null 2>&1; then
    record="$(jq -cn \
      --arg timestamp "$timestamp" \
      --arg atom_id "$task_id" \
      --arg registry "$reg" \
      --arg package "$pkg" \
      --arg resolved_version "$ver" \
      --arg action "$action" \
      '{timestamp:$timestamp,atom_id:$atom_id,registry:$registry,package:$package,
        resolved_version:$resolved_version,source:"agent_runtime",action:$action}' \
      2>/dev/null || true)"
    [ -n "$record" ] \
      && printf '%s\n' "$record" >> "$logfile" 2>/dev/null \
      || true
  fi

  # ECAA_TASK_ID is harness-authored, but keep the path write fail-closed if a
  # malformed value ever reaches this helper.
  case "$task_id" in
    ''|*[!A-Za-z0-9._-]*) return 0 ;;
  esac
  local task_log="$logdir/runtime/outputs/$task_id/scripts/00_install.log"
  mkdir -p "$(dirname "$task_log")" 2>/dev/null || return 0
  printf '[%s] ecaa-install %s %s: version=%s action=%s\n' \
    "$timestamp" "$reg" "$pkg" "$ver" "$action" >> "$task_log" 2>/dev/null || true
}

r_vec() { # join args as an R c("a","b") vector
  local out="" a
  for a in "$@"; do out="${out:+$out, }\"$a\""; done
  printf 'c(%s)' "$out"
}

case "$eco" in
  py|python|pip)
    # PIP_USER + PYTHONUSERBASE + PIP_CACHE_DIR are set by the container, so
    # this lands in the per-session user-site cache and is reused next task.
    "$PY" -m pip install --no-input --disable-pip-version-check "$@"
    _pip_exit=$?
    if [ $_pip_exit -eq 0 ]; then
      for _pkg in "$@"; do
        _ver="$("$PY" -m pip show "$_pkg" 2>/dev/null | awk '/^Version:/{print $2}')" || _ver=""
        _log_install "python" "$_pkg" "${_ver:-}" "resolved"
      done
    fi
    exit $_pip_exit
    ;;
  r|cran)
    pkgs="$(r_vec "$@")"
    "$RSCRIPT" --no-save -e "
      pkgs <- ${pkgs}
      need <- pkgs[!vapply(pkgs, function(p) requireNamespace(p, quietly=TRUE), logical(1))]
      if (length(need)) install.packages(need, repos='${CRAN}', Ncpus=max(1L, parallel::detectCores()))
      ok <- vapply(pkgs, function(p) requireNamespace(p, quietly=TRUE), logical(1))
      if (!all(ok)) { message('ecaa-install: FAILED: ', paste(pkgs[!ok], collapse=', ')); quit(status=1) }
      message('ecaa-install: ok (r): ', paste(pkgs, collapse=', '))
    "
    _r_exit=$?
    if [ $_r_exit -eq 0 ]; then
      for _pkg in "$@"; do
        _ver="$("$RSCRIPT" --no-save -e "cat(as.character(packageVersion('$_pkg')))" 2>/dev/null)" || _ver=""
        _log_install "r" "$_pkg" "${_ver:-}" "resolved"
      done
    fi
    exit $_r_exit
    ;;
  bioc|bioconductor)
    # --- primary path: bioconda pre-built binary into shared 'ecaa-bioc' env ---
    MAMBA="$(command -v mamba 2>/dev/null || command -v conda 2>/dev/null || true)"
    BIOC_ENV="ecaa-bioc"

    # Robust existence check for the shared bioc env. Newer mamba/conda
    # `env list` prints a `Name/Active/Path` header and INDENTS env rows
    # (`  ecaa-bioc   /path`), so the old `grep "^ecaa-bioc[[:space:]]"`
    # (anchored, no leading space) never matched — making every call think the
    # env was absent and run a DESTRUCTIVE `mamba create` that wiped previously
    # installed packages (e.g. DESeq2 clobbered by a later org.Hs.eg.db install;
    # the 2026-06-24 replay regression). Take the first field of each row and
    # match the env name exactly; also accept a direct prefix-dir hit.
    _bioc_env_exists() {
      "$MAMBA" env list 2>/dev/null | awk '{print $1}' | grep -qx "$BIOC_ENV" && return 0
      _old_ifs="$IFS"; IFS=':'
      for _d in ${CONDA_ENVS_DIRS:-}; do
        if [ -n "$_d" ] && [ -d "$_d/$BIOC_ENV" ]; then IFS="$_old_ifs"; return 0; fi
      done
      IFS="$_old_ifs"
      return 1
    }

    # Named conda environments are prefix-bound. Moving a cache directory
    # leaves the old absolute prefix embedded in launchers, R configuration,
    # pkg-config files, TLS paths, and binary metadata. Mounting the moved tree
    # at its new host path does not repair those bytes. Retain the exact prefix
    # at creation and reconstruct the complete environment from `conda list
    # --explicit` when the cache appears at a different path. The explicit lock
    # preserves every package already installed by earlier tasks, unlike
    # recreating from only the package named by the current call.
    _bioc_expected_prefix() {
      local _old_ifs="$IFS" _dir
      IFS=':'
      for _dir in ${CONDA_ENVS_DIRS:-}; do
        if [ -n "$_dir" ]; then
          IFS="$_old_ifs"
          printf '%s/%s\n' "${_dir%/}" "$BIOC_ENV"
          return 0
        fi
      done
      IFS="$_old_ifs"
      "$MAMBA" env list 2>/dev/null \
        | awk -v name="$BIOC_ENV" '$1 == name { print $NF; exit }'
    }

    BIOC_PREFIX="$(_bioc_expected_prefix)"
    BIOC_PREFIX_MARKER="${BIOC_PREFIX:+$BIOC_PREFIX/.ecaa-created-prefix}"
    _bioc_relocation_backup=""

    _refresh_bioc_prefix() {
      BIOC_PREFIX="$(_bioc_expected_prefix)"
      BIOC_PREFIX_MARKER="${BIOC_PREFIX:+$BIOC_PREFIX/.ecaa-created-prefix}"
    }

    _restore_bioc_relocation_backup() {
      if [ -n "$_bioc_relocation_backup" ] \
         && [ ! -d "$BIOC_PREFIX" ] \
         && [ -d "$_bioc_relocation_backup" ]; then
        mv -- "$_bioc_relocation_backup" "$BIOC_PREFIX" 2>/dev/null || true
      fi
    }
    trap _restore_bioc_relocation_backup EXIT HUP INT TERM

    _mark_bioc_prefix() {
      [ -n "$BIOC_PREFIX_MARKER" ] && [ -d "$BIOC_PREFIX" ] || return 0
      printf '%s\n' "$BIOC_PREFIX" > "$BIOC_PREFIX_MARKER"
    }

    _repair_relocated_bioc_env() {
      [ -n "$BIOC_PREFIX" ] && [ -d "$BIOC_PREFIX/conda-meta" ] || return 0
      case "$BIOC_PREFIX" in
        */"$BIOC_ENV") ;;
        *)
          echo "ecaa-install: refusing unsafe conda prefix repair target: $BIOC_PREFIX" >&2
          return 1
          ;;
      esac

      local _recorded=""
      [ -f "$BIOC_PREFIX_MARKER" ] && _recorded="$(cat "$BIOC_PREFIX_MARKER" 2>/dev/null || true)"
      [ "$_recorded" = "$BIOC_PREFIX" ] && return 0

      local _parent _lock _explicit _backup
      _parent="${BIOC_PREFIX%/*}"
      mkdir -p "$_parent" || return 1
      _lock="$_parent/.${BIOC_ENV}.prefix-repair.lock"
      if command -v flock >/dev/null 2>&1; then
        exec 9>"$_lock"
        flock 9
        _recorded=""
        [ -f "$BIOC_PREFIX_MARKER" ] && _recorded="$(cat "$BIOC_PREFIX_MARKER" 2>/dev/null || true)"
        [ "$_recorded" = "$BIOC_PREFIX" ] && return 0
      fi

      _explicit="$(mktemp "$_parent/.${BIOC_ENV}.explicit.XXXXXX")" || return 1
      if ! "$MAMBA" list -p "$BIOC_PREFIX" --explicit > "$_explicit"; then
        rm -f -- "$_explicit"
        echo "ecaa-install: cannot snapshot prefix-bound env '$BIOC_PREFIX' before relocation repair" >&2
        return 1
      fi

      _backup="$_parent/.${BIOC_ENV}.pre-relocation.$$"
      if ! mv -- "$BIOC_PREFIX" "$_backup"; then
        rm -f -- "$_explicit"
        return 1
      fi
      _bioc_relocation_backup="$_backup"
      echo "ecaa-install: rebuilding relocated conda env at current prefix: $BIOC_PREFIX" >&2
      if "$MAMBA" create -y -p "$BIOC_PREFIX" --file "$_explicit"; then
        _mark_bioc_prefix
        _bioc_relocation_backup=""
        rm -rf -- "$_backup"
        rm -f -- "$_explicit"
        return 0
      fi

      rm -rf -- "$BIOC_PREFIX"
      mv -- "$_backup" "$BIOC_PREFIX" 2>/dev/null || true
      _bioc_relocation_backup=""
      rm -f -- "$_explicit"
      echo "ecaa-install: failed to rebuild relocated conda env; restored the prior cache and will not execute it" >&2
      return 1
    }

    if [ -n "$MAMBA" ] && ! _repair_relocated_bioc_env; then
      exit 1
    fi

    _bioc_failed=()   # pkgs that bioconda couldn't satisfy
    _bioc_ok=()

    if [ -n "$MAMBA" ]; then
      # Collect bioconda package names, skip already-installed ones.
      _conda_pkgs=()
      for _pkg in "$@"; do
        _lc="$(printf '%s' "$_pkg" | tr '[:upper:]' '[:lower:]')"
        _conda_name="bioconductor-${_lc}"
        # If env exists, check whether the pkg is already present.
        if _bioc_env_exists; then
          if "$MAMBA" list -n "$BIOC_ENV" 2>/dev/null | grep -qi "^${_conda_name}[[:space:]]"; then
            _ver="$("$MAMBA" list -n "$BIOC_ENV" 2>/dev/null | awk -v p="$_conda_name" 'tolower($1)==p{print $2}' | head -1)" || _ver=""
            echo "ecaa-install: already present (bioc/conda): $_pkg"
            _log_install "conda" "$_pkg" "${_ver:-}" "already_present"
            _bioc_ok+=("$_pkg")
            continue
          fi
        fi
        _conda_pkgs+=("$_conda_name")
      done

      if [ "${#_conda_pkgs[@]}" -gt 0 ]; then
        if _bioc_env_exists; then
          # Env exists — ADD to it (never recreate: create would wipe DESeq2 etc.).
          "$MAMBA" install -y -n "$BIOC_ENV" -c conda-forge -c bioconda "${_conda_pkgs[@]}"
          _conda_exit=$?
        else
          # Env does not exist yet — create it.
          "$MAMBA" create -y -n "$BIOC_ENV" -c conda-forge -c bioconda "${_conda_pkgs[@]}"
          _conda_exit=$?
        fi

        if [ $_conda_exit -ne 0 ]; then
          # Bioconda install failed — all requested pkgs fall through to BiocManager.
          echo "ecaa-install: bioconda install failed (exit $_conda_exit); falling back to BiocManager for: $*" >&2
          _bioc_failed=("$@")
        else
          _refresh_bioc_prefix
          _mark_bioc_prefix
          # Record successes and print usage hints.
          for _pkg in "$@"; do
            _lc="$(printf '%s' "$_pkg" | tr '[:upper:]' '[:lower:]')"
            _conda_name="bioconductor-${_lc}"
            _ver="$("$MAMBA" list -n "$BIOC_ENV" 2>/dev/null | awk -v p="$_conda_name" 'tolower($1)==p{print $2}' | head -1)" || _ver=""
            echo "ecaa-install: ok (bioc): ${_pkg} → conda env '${BIOC_ENV}'; run R with: conda run -n ${BIOC_ENV} Rscript <script>"
            _log_install "conda" "$_pkg" "${_ver:-}" "installed"
            _bioc_ok+=("$_pkg")
          done
        fi
      fi
    else
      # No mamba/conda available at all — fall through to BiocManager for everything.
      echo "ecaa-install: mamba/conda not found; falling back to BiocManager for: $*" >&2
      _bioc_failed=("$@")
    fi

    # --- fallback path: BiocManager install INTO the ecaa-bioc conda env ---
    # Run BiocManager *inside* the env with R_LIBS_USER unset, so packages land
    # in the env's OWN R library — ABI-matched to the env's R and captured
    # wholesale by the env-snapshot, so `ecaa-workflow replay` can reproduce the
    # R compute. A bare `$RSCRIPT` here would install into the external
    # R_LIBS_USER tree (built by a different R), splitting the stack across two
    # libraries that the snapshot cannot reassemble — the cause of the
    # 2026-06-24 replay regression.
    if [ "${#_bioc_failed[@]}" -gt 0 ]; then
      if [ -z "$MAMBA" ]; then
        echo "ecaa-install: FAILED (bioc): no mamba/conda available to host env '${BIOC_ENV}' for: $*" >&2
        exit 1
      fi
      # Ensure the env exists with R + BiocManager (fast conda-forge binaries).
      if _bioc_env_exists; then
        "$MAMBA" install -y -n "$BIOC_ENV" -c conda-forge r-biocmanager >/dev/null 2>&1 || true
      else
        if ! "$MAMBA" create -y -n "$BIOC_ENV" -c conda-forge r-base r-biocmanager; then
          echo "ecaa-install: FAILED (bioc): could not create env '${BIOC_ENV}'" >&2
          exit 1
        fi
        _refresh_bioc_prefix
        _mark_bioc_prefix
      fi
      pkgs="$(r_vec "${_bioc_failed[@]}")"
      # `env -u R_LIBS_USER` so install targets the env's own site library, not
      # the external user tree.
      "$MAMBA" run -n "$BIOC_ENV" env -u R_LIBS_USER Rscript --no-save -e "
        if (!requireNamespace('BiocManager', quietly=TRUE)) install.packages('BiocManager', repos='${CRAN}')
        pkgs <- ${pkgs}
        need <- pkgs[!vapply(pkgs, function(p) requireNamespace(p, quietly=TRUE), logical(1))]
        if (length(need)) BiocManager::install(need, update=FALSE, ask=FALSE, Ncpus=max(1L, parallel::detectCores()))
        ok <- vapply(pkgs, function(p) requireNamespace(p, quietly=TRUE), logical(1))
        if (!all(ok)) { message('ecaa-install: FAILED: ', paste(pkgs[!ok], collapse=', ')); quit(status=1) }
        message('ecaa-install: ok (bioc/BiocManager-in-env fallback): ', paste(pkgs, collapse=', '))
      "
      _biocmgr_exit=$?
      if [ $_biocmgr_exit -eq 0 ]; then
        for _pkg in "${_bioc_failed[@]}"; do
          _ver="$("$MAMBA" run -n "$BIOC_ENV" env -u R_LIBS_USER Rscript --no-save -e "cat(as.character(packageVersion('$_pkg')))" 2>/dev/null)" || _ver=""
          _log_install "conda" "$_pkg" "${_ver:-}" "installed"
          echo "ecaa-install: ok (bioc): ${_pkg} → conda env '${BIOC_ENV}' R library; run R with: conda run -n ${BIOC_ENV} Rscript <script>"
        done
      fi
      exit $_biocmgr_exit
    fi

    # All pkgs satisfied via bioconda.
    exit 0
    ;;
  *)
    echo "ecaa-install: unknown ecosystem '$eco' (expected py|r|bioc)" >&2
    exit 2
    ;;
esac
