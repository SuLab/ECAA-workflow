{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECAA D (Decision) sub-graph",
  "description": "Hand-authored against the SPEC node/edge object model (v0.1.md §5.2), NOT the internal impl types. Validates the spec-shaped projection emitted by crates/core/src/emitter/ecaa_projection.rs::project_subgraph('D', …). Each array element is a typed node or a typed edge; closed `type`/`predicate` enums are pinned to ecaa_workflow_types::consts (asserted by schemars_generation.rs).",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/Node" },
      { "$ref": "#/definitions/Edge" }
    ]
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D:[A-Za-z0-9_.:\\-]+$",
          "description": "Prefix-tagged node id (§4.2)."
        },
        "type": {
          "type": "string",
          "enum": ["MethodChoice", "Justification", "Alternative", "Citation"],
          "description": "Closed D node-type set (§5.2, 4 members)."
        },
        "props": { "type": "object" }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["source_id", "target_id", "predicate"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "predicate": {
          "type": "string",
          "enum": ["chooses", "rejects", "cites", "amends", "prov:wasDerivedFrom"],
          "description": "Closed D edge-predicate set (§5.2, 5 members)."
        }
      },
      "additionalProperties": false
    }
  }
}
