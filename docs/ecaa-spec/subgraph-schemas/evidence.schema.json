{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECAA V (Evidence) sub-graph",
  "description": "Hand-authored against the SPEC node/edge object model (v0.1.md §5.4), NOT the internal impl types. Validates the spec-shaped projection emitted by crates/core/src/emitter/ecaa_projection.rs::project_subgraph('V', …). Each array element is a typed node or a typed edge; closed `type`/`predicate` enums are pinned to ecaa_workflow_types::consts (asserted by schemars_generation.rs).",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/Node" },
      { "$ref": "#/definitions/Edge" }
    ]
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^V:[A-Za-z0-9_.:\\-]+$",
          "description": "Prefix-tagged node id (§4.2)."
        },
        "type": {
          "type": "string",
          "enum": ["Table", "Figure", "Statistic", "File"],
          "description": "Closed V node-type set (§5.4, 4 members)."
        },
        "props": { "type": "object" }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["source_id", "target_id", "predicate"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "predicate": {
          "type": "string",
          "enum": ["appears_in", "computed_from"],
          "description": "Closed V edge-predicate set (§5.4, 2 members)."
        }
      },
      "additionalProperties": false
    }
  }
}
