{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECAA I (Intent) sub-graph",
  "description": "Hand-authored against the SPEC node/edge object model (v0.1.md §5.1), NOT the internal impl types. Validates the spec-shaped projection emitted by crates/core/src/emitter/ecaa_projection.rs::project_subgraph('I', …). Each array element is a typed node or a typed edge; closed `type`/`predicate` enums are pinned to ecaa_workflow_types::consts (asserted by schemars_generation.rs).",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/Node" },
      { "$ref": "#/definitions/Edge" }
    ]
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^I:[A-Za-z0-9_\\-]+$",
          "description": "Prefix-tagged node id (§4.2)."
        },
        "type": {
          "type": "string",
          "enum": ["Question", "Cohort", "Contrast", "Modality", "ExpectedOutput"],
          "description": "Closed I node-type set (§5.1, 5 members)."
        },
        "props": { "type": "object" }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["source_id", "target_id", "predicate"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "predicate": {
          "type": "string",
          "enum": ["refines", "stratifies", "expects"],
          "description": "Closed I edge-predicate set (§5.1, 3 members)."
        }
      },
      "additionalProperties": false
    }
  }
}
