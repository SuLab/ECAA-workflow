{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "EvaluatorInfo": {
      "description": "Evaluator provenance — informative per invariants.md §\"audit-proof-report.json shape\".",
      "properties": {
        "impl": {
          "description": "Implementation identifier.",
          "type": "string"
        },
        "policy": {
          "description": "Warn/fail policy: \"warn-only\" | \"strict\" (absent ⇒ normative defaults).",
          "type": "string"
        },
        "version": {
          "description": "Evaluator implementation version.",
          "type": "string"
        }
      },
      "required": [
        "impl",
        "policy",
        "version"
      ],
      "type": "object"
    },
    "InvariantId": {
      "enum": [
        "claim_completeness",
        "decision_justification",
        "evidence_coverage",
        "equivalence_failure",
        "cross_graph_integrity",
        "substrate_validity"
      ],
      "type": "string"
    },
    "InvariantStatus": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "unverified"
      ],
      "type": "string"
    },
    "InvariantVerdict": {
      "properties": {
        "detail": {
          "description": "Human-readable detail when status != Pass.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/definitions/InvariantId"
        },
        "n_inspected": {
          "description": "Items inspected (e.g., number of claims, decisions, edges).",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "n_violations": {
          "description": "Items violating the invariant.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/InvariantStatus"
        }
      },
      "required": [
        "id",
        "n_inspected",
        "n_violations",
        "status"
      ],
      "type": "object"
    }
  },
  "properties": {
    "ecaa_version": {
      "description": "ECAA spec version this package conforms to (§9.2). Required.",
      "type": "string"
    },
    "evaluated_at": {
      "description": "RFC-3339 timestamp the report was produced. Excluded from the BagIt manifest so it does not break byte-reproducibility.",
      "type": [
        "string",
        "null"
      ]
    },
    "evaluator": {
      "allOf": [
        {
          "$ref": "#/definitions/EvaluatorInfo"
        }
      ],
      "description": "Evaluator provenance (informative)."
    },
    "max_reader_version": {
      "description": "Maximum reader version, when the emitter pins an upper bound (§9.2).",
      "type": [
        "string",
        "null"
      ]
    },
    "min_reader_version": {
      "description": "Minimum reader version required to consume the package (§9.2). Required.",
      "type": "string"
    },
    "package_iri": {
      "description": "IRI (or relative path) of the package's ro-crate-metadata.json.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "description": "On-disk schema version of this report shape.",
      "type": "string"
    },
    "verdicts": {
      "description": "Per-invariant verdicts.",
      "items": {
        "$ref": "#/definitions/InvariantVerdict"
      },
      "type": "array"
    }
  },
  "required": [
    "ecaa_version",
    "evaluator",
    "min_reader_version",
    "schema_version",
    "verdicts"
  ],
  "title": "AuditProofReport",
  "type": "object"
}
