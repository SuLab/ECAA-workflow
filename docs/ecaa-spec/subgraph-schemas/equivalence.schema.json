{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECAA Q (Equivalence) sub-graph",
  "description": "Hand-authored against the SPEC node/edge object model (v0.2.md §5.6), NOT the internal impl types. Validates the spec-shaped projection emitted by crates/core/src/emitter/ecaa_projection.rs::project_subgraph('Q', …). Each array element is a typed node or a typed edge; closed `type`/`predicate` enums are pinned to ecaa_workflow_types::consts (asserted by schemars_generation.rs). Empty at emit time (re-execution runs post-emit).",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/Node" },
      { "$ref": "#/definitions/Edge" }
    ]
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q:[A-Za-z0-9_.:\\-]+$",
          "description": "Prefix-tagged node id (§4.2)."
        },
        "type": {
          "type": "string",
          "enum": ["RerunOutcome"],
          "description": "Closed Q node-type set (§5.6, 1 member)."
        },
        "props": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "byte_identical",
                "semantic_equivalent",
                "acknowledged_non_determinism",
                "unavailable",
                "failed"
              ],
              "description": "Closed RerunOutcome.class set (§5.6, 5 values)."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["source_id", "target_id", "predicate"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "predicate": {
          "type": "string",
          "enum": ["equivalent_to", "diverges_from"],
          "description": "Closed Q edge-predicate set (§5.6, 2 members)."
        }
      },
      "additionalProperties": false
    }
  }
}
