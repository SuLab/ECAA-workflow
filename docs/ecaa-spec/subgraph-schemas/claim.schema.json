{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECAA C (Claim) sub-graph",
  "description": "Hand-authored against the SPEC node/edge object model (v0.1.md §5.5), NOT the internal impl types. Validates the spec-shaped projection emitted by crates/core/src/emitter/ecaa_projection.rs::project_subgraph('C', …). Each array element is a typed node or a typed edge; closed `type`/`predicate` enums are pinned to ecaa_workflow_types::consts (asserted by schemars_generation.rs).",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/definitions/Node" },
      { "$ref": "#/definitions/Edge" }
    ]
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "props"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C:[A-Za-z0-9_.:\\-]+$",
          "description": "Prefix-tagged node id (§4.2)."
        },
        "type": {
          "type": "string",
          "enum": ["Claim", "Quantification", "Direction"],
          "description": "Closed C node-type set (§5.5, 3 members)."
        },
        "props": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["verified", "pending", "contradicted"],
              "description": "Closed Claim status set (§5.5, 3 values)."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["source_id", "target_id", "predicate"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "predicate": {
          "type": "string",
          "enum": ["supported_by", "contradicts"],
          "description": "Closed C edge-predicate set (§5.5, 2 members)."
        }
      },
      "additionalProperties": false
    }
  }
}
