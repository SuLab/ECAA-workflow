@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ecaa: <https://w3id.org/ecaa/ns/0.2#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#######################################################################
# SHACL shapes for the ECAA v0.2 audit-proof invariants.
# All six invariants are runnable SHACL here; ecaa-v0.2.ttl retains the
# equivalent OWL-DL restrictions for Invariants 1, 3, 5 for the
# OWL-consistency path (the two are dual encodings, not alternatives).
#
# Per-shape sh:severity → two conformsTo tiers (registration/ecaa-profiles.ttl):
#   substrate-hygiene  (sh:Violation) — attested-at-rest floor an adopter can
#     satisfy on a WRROC substrate alone: Inv 2 (decision_justification),
#     Inv 6 (substrate_validity + its execution-consistency sub-check).
#   apparatus          (sh:Warning)   — the full ECAA contract's carried /
#     runtime-enforced shapes: Inv 1 (claim_completeness), Inv 3
#     (evidence_coverage), Inv 4 (equivalence_failure), Inv 5
#     (cross_graph_integrity).
# Under pyshacl, sh:Warning does NOT set conforms=False, so the existing
# hygiene gate (fail on conforms==false) keeps grading the floor; the
# apparatus gate (Task 6 helper) additionally fails on any sh:Warning.
#######################################################################

# Invariant 2: decision_justification
# Every MethodChoice has either ≥1 cites edge OR rationale string ≥30 chars.

ecaa:DecisionJustificationShape a sh:NodeShape ;
    sh:targetClass ecaa:MethodChoice ;
    sh:severity sh:Violation ;     # substrate-hygiene tier
    sh:or (
        [ sh:path ecaa:cites ; sh:minCount 1 ]
        [ sh:path ecaa:rationale ; sh:datatype xsd:string ; sh:minLength 30 ]
    ) ;
    sh:message "Invariant 2 (decision_justification): MethodChoice must have ≥1 cites edge OR rationale ≥30 chars" .

ecaa:rationale a rdfs:Property ;
    rdfs:label "rationale"@en .

# Invariant 4: equivalence_failure
# Every RerunOutcome with class `failed` or `non-deterministic`
# has a corresponding F Blocker of kind `UnprovableEdge` or `PolicyException`.

ecaa:EquivalenceFailureShape a sh:NodeShape ;
    sh:targetClass ecaa:RerunOutcome ;
    sh:severity sh:Warning ;     # apparatus tier (apparatus-fed)
    sh:sparql [
        sh:select """
            PREFIX ecaa: <https://w3id.org/ecaa/ns/0.2#>
            SELECT $this WHERE {
                $this ecaa:class ?class .
                FILTER (?class IN (ecaa:failed, ecaa:nonDeterministic))
                FILTER NOT EXISTS {
                    ?blocker a ecaa:Blocker ;
                             ecaa:kind ?kind ;
                             ecaa:refs $this .
                    FILTER (?kind IN ("UnprovableEdge", "PolicyException"))
                }
            }
        """ ;
        sh:message "Invariant 4 (equivalence_failure): RerunOutcome with class failed/non-deterministic must have a Blocker of kind UnprovableEdge or PolicyException"
    ] .

# Invariant 6: substrate_validity (EXECUTION-AWARE conformsTo — amended
# 2026-06-25, user-approved ecaa/v0.2 amendment after the T6 honesty audit).
#
# Structural: the package descriptor must declare the required profile IRIs
# its graph TRUTHFULLY satisfies. Which profiles are required depends on
# whether the crate records a real execution:
#
#   - A workflow-DEFINITION / PLAN crate — one that records NO real run
#     (no `CreateAction` with an `instrument`) — describes a workflow
#     definition only, so it can honestly claim ONLY the three DEFINITION
#     profiles: RO-Crate 1.1 + WorkflowHub Workflow-RO-Crate 1.0 + ECAA v0.2.
#     Claiming a WRROC v0.5 RUN profile (process/workflow/provenance) on a
#     crate with no executed run would be an over-claim, so a plan crate is
#     required to declare ⊇ the 3 definition profiles (it MAY declare more,
#     but the 3 are the honest floor it must meet).
#
#   - An EXECUTED crate — one that records ≥1 real run `CreateAction` with an
#     `instrument` (the retrospective per-output actions the finalize path
#     appends) — additionally documents executed processes / a workflow run /
#     full provenance, so it MUST declare all 6 profile IRIs (the 3 definition
#     profiles + the 3 WRROC v0.5 run profiles).
#
# `ecaa:recordsExecution` is a projection-side boolean the harness stamps on
# the synthesized `ecaa:Package` node, derived from the RO-Crate `@graph`
# exactly as the Rust emitter's `graph_has_run_create_action` (an entity typed
# `CreateAction` carrying an `instrument` @id). It is a projection sentinel,
# NOT an ECAA closed predicate. The two `sh:or` branches are mutually
# exclusive on that boolean, so exactly one branch grades any given crate:
# plan crates are held to the 3-profile floor, executed crates to all 6 — the
# rule is HONEST (plan→3, executed→6), never "accept anything".
#
# (The runcrate parseability check is performed by the Python conformance
# harness, not by SHACL — this shape catches the structural prerequisites.)

ecaa:SubstrateValidityShape a sh:NodeShape ;
    sh:targetClass ecaa:Package ;
    sh:severity sh:Violation ;     # substrate-hygiene tier
    sh:or (
        # Branch A — PLAN crate (records NO real execution): must declare ⊇ the
        # 3 DEFINITION profiles. Guarded by recordsExecution = false so it
        # cannot grade an executed crate.
        [
            sh:and (
                [ sh:path ecaa:recordsExecution ; sh:hasValue false ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ro/crate/1.1> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ecaa/v0.2> ]
            )
        ]
        # Branch B — EXECUTED crate (records ≥1 real run CreateAction with an
        # instrument): must declare ALL 6 profiles. Guarded by
        # recordsExecution = true so it cannot grade a plan crate.
        [
            sh:and (
                [ sh:path ecaa:recordsExecution ; sh:hasValue true ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ro/crate/1.1> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/workflowhub/workflow-ro-crate/1.0> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ro/wfrun/process/0.5> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ro/wfrun/workflow/0.5> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ro/wfrun/provenance/0.5> ]
                [ sh:path dcterms:conformsTo ; sh:hasValue <https://w3id.org/ecaa/v0.2> ]
            )
        ]
    ) ;
    sh:message "Invariant 6 (substrate_validity): a plan crate (no real run CreateAction) must declare ⊇ the 3 definition profiles (RO-Crate 1.1 + Workflow-RO-Crate 1.0 + ECAA v0.2); an executed crate (≥1 real run CreateAction with an instrument) must declare all 6 (definition profiles + WRROC v0.5 Process/Workflow/Provenance)" .

# Invariant 3: evidence_coverage (runnable SHACL — the second-impl encoding
# that agrees with the Rust `check_evidence_coverage`; the equivalent OWL-DL
# restriction is retained in ecaa-v0.2.ttl for the OWL-consistency path).
# Every V OutputFile must be referenced by a Claim `supported_by` edge OR
# acknowledged by an `OutputUnused` Blocker carve-out.

ecaa:EvidenceCoverageShape a sh:NodeShape ;
    sh:targetClass ecaa:OutputFile ;
    sh:severity sh:Warning ;     # apparatus tier
    sh:sparql [
        sh:select """
            PREFIX ecaa: <https://w3id.org/ecaa/ns/0.2#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?claim ecaa:supported_by $this . }
                FILTER NOT EXISTS {
                    ?blk a ecaa:Blocker ;
                         ecaa:kind "OutputUnused" ;
                         ecaa:refs $this .
                }
            }
        """ ;
        sh:message "Invariant 3 (evidence_coverage): every OutputFile must be supported_by a Claim or acknowledged OutputUnused"
    ] .

# Invariant 1: claim_completeness (referential form; runnable SHACL — the
# second-impl encoding that agrees with the Rust `check_claim_completeness`;
# the equivalent OWL-DL restriction is retained in ecaa-v0.2.ttl).
# Every Claim is either pending OR has ≥1 supported_by edge.

ecaa:ClaimCompletenessShape a sh:NodeShape ;
    sh:targetClass ecaa:Claim ;
    sh:severity sh:Warning ;     # apparatus tier
    sh:or (
        [ sh:path ecaa:status ; sh:hasValue "pending" ]
        [ sh:path ecaa:supported_by ; sh:minCount 1 ]
    ) ;
    sh:message "Invariant 1 (claim_completeness): Claim must be pending OR have ≥1 supported_by edge" .

# Invariant 5: cross_graph_integrity (C→V referential resolution; runnable
# SHACL — the second-impl encoding that agrees with the Rust
# `check_cross_graph_integrity` for the concrete C→V form; the equivalent
# OWL-DL `supported_by` rdfs:range union is retained in ecaa-v0.2.ttl).
# Every `supported_by` object must resolve to a node typed in the V (Evidence)
# graph (OutputFile / Table / Figure / Statistic / File).

ecaa:CrossGraphIntegrityShape a sh:NodeShape ;
    sh:targetObjectsOf ecaa:supported_by ;
    sh:severity sh:Warning ;     # apparatus tier
    sh:or (
        [ sh:class ecaa:OutputFile ] [ sh:class ecaa:Table ]
        [ sh:class ecaa:Figure ] [ sh:class ecaa:Statistic ] [ sh:class ecaa:File ]
    ) ;
    sh:message "Invariant 5 (cross_graph_integrity): supported_by must resolve to a V (Evidence) node" .

# Invariant 6 sub-check: execution-consistency (single-source E, F11).
# Execution is materialized twice — the authoritative WRROC @graph HowToStep
# lineage and the E sidecar (proofs.jsonl) WorkflowStep set. This shape folds
# UNDER Invariant 6 (substrate_validity); it adds NO 7th invariant. `_project.py`
# tags each derived WorkflowStep with `appears_in ecaa:graph` (the single
# source) and/or `appears_in ecaa:evidence`; a step in one materialization but
# not the other is drift. (`ecaa:graph`/`ecaa:evidence` are projection-side
# sentinel individuals, not ECAA closed predicates.)

ecaa:ExecutionConsistencyShape a sh:NodeShape ;
    sh:targetClass ecaa:WorkflowStep ;
    sh:severity sh:Violation ;     # substrate-hygiene tier (Inv 6 sub-check)
    sh:sparql [
        sh:select """
            PREFIX ecaa: <https://w3id.org/ecaa/ns/0.2#>
            SELECT $this WHERE {
                { $this ecaa:appears_in ecaa:graph .
                  FILTER NOT EXISTS { $this ecaa:appears_in ecaa:evidence . } }
                UNION
                { $this ecaa:appears_in ecaa:evidence .
                  FILTER NOT EXISTS { $this ecaa:appears_in ecaa:graph . } }
            }
        """ ;
        sh:message "Invariant 6 (execution-consistency): every execution step must appear in both the WRROC @graph and the E sidecar (no materialization drift)"
    ] .
